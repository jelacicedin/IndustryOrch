# ============================================================================
# IndustryOrch Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values for your setup.

# ---------------------------------------------------------------------------
# PostgreSQL (pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=industryorch
POSTGRES_PASSWORD=password
POSTGRES_DB=industryorch
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Ollama — embedding model + optional generation backend
# For Docker Compose: http://ollama:11434 (internal network)
# For local dev / llama_cpp backend: use host.docker.internal or localhost
# ---------------------------------------------------------------------------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_PORT=11434

# Embedding model (always Ollama)
EMBED_MODEL=qwen3-embedding:0.6b

# Generation model used when GEN_BACKEND=ollama
GENERATION_MODEL=qwen3:14b

# Enable extended thinking by default (Ollama only)
OLLAMA_THINK=true

# Vision model for image/diagram description in PDFs (optional)
# Leave empty to skip image description entirely (presence still noted in markdown)
#
# Recommended options (speed vs quality tradeoff):
#   moondream   — ~1.8B params, ~1.1GB, fastest, good for charts/diagrams
#   llava:7b    — ~7B params, ~4.1GB, slower, richer descriptions
#   minicpm-v   — ~8B params, strong on technical/OCR content
VISION_MODEL=moondream

# ---------------------------------------------------------------------------
# Generation backend
#   ollama      — use Ollama /api/chat endpoint (default)
#   llama_cpp   — use llama.cpp server /v1/chat/completions endpoint
# ---------------------------------------------------------------------------
GEN_BACKEND=ollama

# ---------------------------------------------------------------------------
# llama.cpp server settings (only used when GEN_BACKEND=llama_cpp)
# ---------------------------------------------------------------------------
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_PORT=8080

# Path to GGUF model file on the host (for docker-compose llama-server service)
MODEL_PATH=/path/to/models
MODEL_FILE=qwen3-27b.Q4_K_M.gguf

# ---------------------------------------------------------------------------
# Neo4j — knowledge graph store
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=industryorch2026

# Graph extraction backend
#   GRAPH_USE_LLM=true  — Ollama LLM (richer, slower, requires qwen2.5:1.5b pulled)
#   GRAPH_USE_LLM=false — GLiNER + spaCy (10-50x faster, CPU-only, no Ollama needed)
GRAPH_USE_LLM=true
GRAPH_EXTRACTION_MODEL=qwen3:14b   # Ollama model (only used when GRAPH_USE_LLM=true)
GRAPH_BATCH_SIZE=3                    # Chunks per LLM call (only used when GRAPH_USE_LLM=true)

# HuggingFace token — avoids rate limits when downloading GLiNER at build time
# Get yours free at https://huggingface.co/settings/tokens (read-only scope is enough)
HF_TOKEN=

# NLP path settings (only used when GRAPH_USE_LLM=false)
GLINER_MODEL=urchade/gliner_medium-v2.1  # HuggingFace model ID (~137M params)
GRAPH_NLP_MODEL=en_core_web_sm           # spaCy pipeline (installed in Docker image)
GLINER_THRESHOLD=0.4                     # Min entity confidence score (0.0–1.0)

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
APP_PORT=8001
UVICORN_RELOAD=false
