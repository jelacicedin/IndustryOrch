# ============================================================================
# IndustryOrch Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values for your setup.

# ---------------------------------------------------------------------------
# PostgreSQL (pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=industryorch
POSTGRES_PASSWORD=password
POSTGRES_DB=industryorch
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Ollama — embedding model + optional generation backend
# For Docker Compose: http://ollama:11434 (internal network)
# For local dev / llama_cpp backend: use host.docker.internal or localhost
# ---------------------------------------------------------------------------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_PORT=11434

# Embedding model (always Ollama)
EMBED_MODEL=qwen3-embedding:0.6b

# Generation model used when GEN_BACKEND=ollama
GENERATION_MODEL=qwen3:14b

# Enable extended thinking by default (Ollama only)
OLLAMA_THINK=true

# Vision model for image/diagram description (hybrid mode) or full-page
# extraction (vision mode). Leave empty to skip image description entirely.
#
# Recommended options (speed vs quality tradeoff):
#   moondream   — ~1.8B params, ~1.1GB, fastest; OK for descriptions, weak on tables
#   llava:7b    — ~7B params, ~4.1GB, decent structured extraction
#   minicpm-v   — ~8B params, best local option for tables and technical content
VISION_MODEL=moondream

# PDF extraction mode:
#   hybrid  (default) — PyMuPDF text + pdfplumber tables + optional image description
#   vision  — render each page to image, send to VISION_MODEL for full extraction
#             handles borderless tables, multi-column layouts, scanned PDFs;
#             quality is capped by your vision model (minicpm-v recommended)
PDF_EXTRACT_MODE=hybrid

# Page render resolution for vision mode (default 2.0 = 144 DPI). Increase to
# 3.0 for dense small-print documents; decrease to 1.5 to reduce image size.
PDF_VISION_DPI_SCALE=2.0

# ---------------------------------------------------------------------------
# Generation backend
#   ollama      — use Ollama /api/chat endpoint (default)
#   llama_cpp   — use llama.cpp server /v1/chat/completions endpoint
# ---------------------------------------------------------------------------
GEN_BACKEND=ollama

# ---------------------------------------------------------------------------
# llama.cpp server settings (only used when GEN_BACKEND=llama_cpp)
# ---------------------------------------------------------------------------
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_PORT=8080

# Path to GGUF model file on the host (for docker-compose llama-server service)
MODEL_PATH=/path/to/models
MODEL_FILE=qwen3-27b.Q4_K_M.gguf

# ---------------------------------------------------------------------------
# Neo4j — knowledge graph store
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=industryorch2026

# Graph extraction (Ollama LLM)
GRAPH_EXTRACTION_MODEL=qwen3:14b
GRAPH_BATCH_SIZE=3

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
APP_PORT=8001
UVICORN_RELOAD=false
